# Anthropic API key (https://platform.claude.com). Never put this in the mobile app.
ANTHROPIC_API_KEY=sk-ant-...
# OAuth client IDs whose Google ID tokens are accepted (web, iOS, Android), comma-separated.
GOOGLE_CLIENT_IDS=xxxxxxxx-web.apps.googleusercontent.com,xxxxxxxx-ios.apps.googleusercontent.com
# Optional limits (protect your Anthropic bill: any Google account can sign in to the app)
PORT=8787
SCANS_PER_HOUR=30
SCANS_PER_DAY=100
MAX_CONCURRENT_SCANS=20
# ANTHROPIC_MODEL=claude-opus-5-5
